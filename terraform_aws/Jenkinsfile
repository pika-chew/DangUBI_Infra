// terraform_aws CI/CD 파이프라인 (Multibranch Pipeline Job)
//
// 트리거와 경로 필터는 Jenkins 잡 설정에서 관리합니다. (이 파일에 triggers 블록을 두지 않습니다.)
// - Build Configuration > Script Path: terraform_aws/Jenkinsfile
// - Scan Repository Triggers > Periodically if not otherwise run: 5분
//   (주기적 스캔으로 새 PR과 새 커밋을 감지합니다. pollSCM은 build strategy 필터를 거치지 않을 수 있어 사용하지 않습니다.)
// - Branch Sources (GitHub) > Behaviours: main과 PR만 빌드합니다. 작업 브랜치 push는 PR이 없으면 빌드하지 않습니다.
//   - Discover branches: Exclude branches that are also filed as PRs
//   - Discover pull requests from origin: Merging the pull request with the current target branch revision
//   - Discover pull requests from forks: 추가하지 않습니다. (PR 빌드에 AWS 자격증명이 사용됩니다.)
//   - Filter by name (with wildcards) > Include: main PR-*
//     (main을 빼면 머지 후 Apply가 실행되지 않습니다. PR-*는 대상 브랜치를 구분하지 않습니다.)
// - Branch Sources > Build strategies: "Accept build by included regions strategy" (Multibranch Build Strategy Extension 플러그인)
//   - Included regions: terraform_aws/**
//   - 다른 strategy는 추가하지 않습니다. 함께 넣으면 경로 필터를 우회할 수 있습니다.
//   - 수동 실행(Build Now)은 필터와 관계없이 실행됩니다.
//
// 운영 Lambda 배포는 이 파이프라인이 담당합니다.
// - Lambda Jenkins: ECR 업로드 → 임시 Lambda 배포·스모크 테스트 → 통과한 digest를 processing-image.auto.tfvars.json에 기록해 main에 push
// - 이 파이프라인: 그 커밋을 감지 → Plan → Approve → Apply로 운영 Lambda 교체 → Smoke Test
// - image_uri 변경도 다른 변경과 같이 승인해야 적용됩니다. 자동 롤백은 없으므로 실패하면 digest 커밋을 되돌려 복구합니다.

pipeline {
    agent any

    options {
        disableConcurrentBuilds()
        timestamps()
        skipDefaultCheckout()
    }

    environment {
        TF_DIR              = 'terraform_aws'
        TF_VERSION          = '1.17.0'
        TF_IN_AUTOMATION    = 'true'    // Terraform이 CI/CD 환경임을 인식하도록 합니다.
        TF_INPUT            = 'false'

        // Jenkins 홈(영구 볼륨)에 provider를 캐시해 cleanWs 후에도 다시 받지 않도록 합니다.
        TF_PLUGIN_CACHE_DIR = "${JENKINS_HOME}/.terraform.d/plugin-cache"
        TFLINT_PLUGIN_DIR   = "${JENKINS_HOME}/.tflint.d/plugins"

        TFLINT_VERSION      = 'v0.65.0'
        GITLEAKS_VERSION    = 'v8.30.1'
        CHECKOV_VERSION     = '3.4.3'
        PYTHON_VERSION      = '3.13-alpine'
        AWS_CLI_VERSION     = '2.39.4'
        AWS_REGION          = 'ap-northeast-2'

        SLACK_CHANNEL       = '#jenkins'
    }

    stages {
        stage('Checkout') {
            steps {
                cleanWs()
                checkout scm
            }
            post {
                failure {
                    script { env.FAILED_STAGE = STAGE_NAME }
                }
            }
        }

        stage('Terraform Init') {
            // AWS에 접근하는 stage(Init, Plan, Apply, Smoke Test)에만 Terraform 전용 IAM 사용자 키를 줍니다. (Secret text)
            environment {
                AWS_ACCESS_KEY_ID     = credentials('aws-terraform-access-key-id')
                AWS_SECRET_ACCESS_KEY = credentials('aws-terraform-secret-access-key')
            }
            agent {
                docker {
                    image "hashicorp/terraform:${TF_VERSION}"
                    args '--entrypoint='    // Terraform은 entrypoint가 있어 docker run 시 명령어를 덮어쓰므로 entrypoint를 제거합니다.
                    reuseNode true
                }
            }
            steps {
                dir(TF_DIR) {
                    sh '''
                        mkdir -p "$TF_PLUGIN_CACHE_DIR"     
                        terraform version
                        terraform init -no-color
                    '''
                }
            }
            post {
                failure {
                    script { env.FAILED_STAGE = STAGE_NAME }
                }
            }
        }

        stage('Static Check') {
            parallel {
                stage('Format') {
                    agent {
                        docker {
                            image "hashicorp/terraform:${TF_VERSION}"
                            args '--entrypoint='
                            reuseNode true
                        }
                    }
                    steps {
                        dir(TF_DIR) {
                            sh 'terraform fmt -check -recursive -diff -no-color'
                        }
                    }
                    post {
                        failure {
                            // 동시에 실패할 수 있어 실패한 검사 이름을 누적합니다.
                            script { env.STATIC_CHECK_FAILED = env.STATIC_CHECK_FAILED ? "${env.STATIC_CHECK_FAILED}, ${STAGE_NAME}" : STAGE_NAME }
                        }
                    }
                }

                stage('Validate') {
                    agent {
                        docker {
                            image "hashicorp/terraform:${TF_VERSION}"
                            args '--entrypoint='
                            reuseNode true
                        }
                    }
                    steps {
                        dir(TF_DIR) {
                            sh 'terraform validate -no-color'
                        }
                    }
                    post {
                        failure {
                            script { env.STATIC_CHECK_FAILED = env.STATIC_CHECK_FAILED ? "${env.STATIC_CHECK_FAILED}, ${STAGE_NAME}" : STAGE_NAME }
                        }
                    }
                }

                stage('Lint') {
                    agent {
                        docker {
                            image "ghcr.io/terraform-linters/tflint:${TFLINT_VERSION}"
                            // 기본 브리지(MTU 1500)에서는 VM NIC(MTU 1450)보다 커서 플러그인 다운로드의 TLS 핸드셰이크가 멈출 수 있습니다.
                            // 플러그인 서명 검증 캐시를 쓸 수 있도록 HOME을 지정합니다.
                            args '--entrypoint= --network host -e HOME=/tmp'
                            reuseNode true
                        }
                    }
                    steps {
                        dir(TF_DIR) {
                            sh '''
                                mkdir -p "$TFLINT_PLUGIN_DIR"
                                tflint --init
                                tflint --recursive --config "$(pwd)/.tflint.hcl" --format compact
                            '''
                        }
                    }
                    post {
                        failure {
                            script { env.STATIC_CHECK_FAILED = env.STATIC_CHECK_FAILED ? "${env.STATIC_CHECK_FAILED}, ${STAGE_NAME}" : STAGE_NAME }
                        }
                    }
                }

                stage('Secret Scan') {
                    agent {
                        docker {
                            image "zricethezav/gitleaks:${GITLEAKS_VERSION}"
                            args '--entrypoint='
                            reuseNode true
                        }
                    }
                    steps {
                        dir(TF_DIR) {
                            sh 'gitleaks dir . --config .gitleaks.toml --redact --no-banner --verbose'
                        }
                    }
                    post {
                        failure {
                            script { env.STATIC_CHECK_FAILED = env.STATIC_CHECK_FAILED ? "${env.STATIC_CHECK_FAILED}, ${STAGE_NAME}" : STAGE_NAME }
                        }
                    }
                }
            }
            post {
                failure {
                    script { env.FAILED_STAGE = env.STATIC_CHECK_FAILED ? "${STAGE_NAME} (${env.STATIC_CHECK_FAILED})" : STAGE_NAME }
                }
            }
        }

        stage('Security') {
            agent {
                docker {
                    image "bridgecrew/checkov:${CHECKOV_VERSION}"
                    args '--entrypoint='
                    reuseNode true
                }
            }
            steps {
                dir(TF_DIR) {
                    // 실패해도 리포트를 남긴 뒤 같은 종료 코드로 끝내 Slack 알림에 실패 항목을 담습니다.
                    sh '''
                        set +e
                        checkov -d . --config-file .checkov.yaml -o cli --output-file-path checkov-report
                        rc=$?
                        set -e
                        cat checkov-report/results_cli.txt
                        if [ "$rc" -ne 0 ]; then
                            awk '/^Check: /{ id=$2; sub(/:$/, "", id); name=$0; sub(/^[^"]*"/, "", name); sub(/"[^"]*$/, "", name) }
                                 /FAILED for resource:/{ res=$NF }
                                 /^[[:space:]]*File: /{ print "- " id " " res " (" $2 ")\\n    " name }' \
                                checkov-report/results_cli.txt > checkov-summary.txt
                        fi
                        exit $rc
                    '''
                }
            }
            post {
                always {
                    archiveArtifacts artifacts: "${TF_DIR}/checkov-report/**", allowEmptyArchive: true
                }
                failure {
                    script {
                        env.FAILED_STAGE = 'Security (Checkov)'
                        def summary = "${TF_DIR}/checkov-summary.txt"
                        env.FAILURE_DETAIL = fileExists(summary) ? readFile(summary).trim() : ''
                    }
                }
            }
        }

        stage('Plan') {
            environment {
                AWS_ACCESS_KEY_ID     = credentials('aws-terraform-access-key-id')
                AWS_SECRET_ACCESS_KEY = credentials('aws-terraform-secret-access-key')
            }
            agent {
                docker {
                    image "hashicorp/terraform:${TF_VERSION}"
                    args '--entrypoint='
                    reuseNode true
                }
            }
            steps {
                dir(TF_DIR) {
                    // 다른 브랜치 빌드와 state lock이 겹치면 최대 5분까지 기다립니다.
                    sh '''
                        terraform plan -no-color -lock-timeout=5m -out=tfplan
                        terraform show -no-color tfplan > tfplan.txt
                        terraform show -json tfplan > tfplan.json
                    '''
                }
            }
            post {
                failure {
                    script { env.FAILED_STAGE = STAGE_NAME }
                }
            }
        }

        stage('Analyze') {
            agent {
                docker {
                    image "python:${PYTHON_VERSION}"
                    reuseNode true
                }
            }
            steps {
                dir(TF_DIR) {
                    sh 'python3 scripts/analyze-plan.py tfplan.json'
                    script {
                        def flags = readFile('plan-flags')
                        env.HAS_CHANGES     = flags.contains('HAS_CHANGES=true') ? 'true' : 'false'
                        env.HAS_DESTRUCTIVE = flags.contains('HAS_DESTRUCTIVE=true') ? 'true' : 'false'
                        env.PLAN_SUMMARY    = readFile('plan-summary.txt').trim()
                    }
                }
            }
            post {
                failure {
                    script { env.FAILED_STAGE = STAGE_NAME }
                }
            }
        }

        stage('Approve') {
            when {
                allOf {
                    branch 'main'
                    environment name: 'HAS_CHANGES', value: 'true'
                }
            }
            steps {
                script {
                    def planType = env.HAS_DESTRUCTIVE == 'true' ? '삭제·교체가 포함된 plan' : 'plan'
                    slackSend(
                        channel: env.SLACK_CHANNEL,
                        color: 'warning',
                        message: ":warning: *${env.JOB_NAME}* #${env.BUILD_NUMBER} ${planType} 승인 대기\n" +
                                 "```\n${env.PLAN_SUMMARY}\n```\n" +
                                 "<${env.BUILD_URL}input|승인하러 가기>"
                    )
                    // 30분 안에 승인하지 않으면 빌드가 중단(ABORTED)됩니다.
                    // TODO: input에 submitter를 지정해 승인할 수 있는 Jenkins 계정을 제한합니다.
                    env.APPROVAL_PENDING = 'true'
                    timeout(time: 30, unit: 'MINUTES') {
                        input message: "${planType}을 적용할까요?", ok: 'Apply'
                    }
                    env.APPROVAL_PENDING = 'false'
                }
            }
        }

        stage('Apply') {
            environment {
                AWS_ACCESS_KEY_ID     = credentials('aws-terraform-access-key-id')
                AWS_SECRET_ACCESS_KEY = credentials('aws-terraform-secret-access-key')
            }
            when {
                beforeAgent true    // 건너뛸 때 컨테이너를 띄우지 않도록 agent 전에 조건을 확인합니다.
                allOf {
                    branch 'main'
                    environment name: 'HAS_CHANGES', value: 'true'
                }
            }
            agent {
                docker {
                    image "hashicorp/terraform:${TF_VERSION}"
                    args '--entrypoint='
                    reuseNode true
                }
            }
            steps {
                dir(TF_DIR) {
                    // 저장한 plan만 적용합니다. plan 이후 state가 바뀌었으면 Terraform이 적용을 거부합니다.
                    sh 'terraform apply -no-color -input=false -lock-timeout=5m tfplan'
                }
            }
            post {
                failure {
                    script { env.FAILED_STAGE = STAGE_NAME }
                }
            }
        }

        
        stage('Smoke Test') {
            environment {
                AWS_ACCESS_KEY_ID     = credentials('aws-terraform-access-key-id')
                AWS_SECRET_ACCESS_KEY = credentials('aws-terraform-secret-access-key')
            }
            when {
                branch 'main'
            }
            steps {
                script {
                    docker.image("hashicorp/terraform:${TF_VERSION}").inside('--entrypoint=') {
                        dir(TF_DIR) {
                            sh '''
                                {
                                    echo "KINESIS_STREAM_NAME=$(terraform output -raw kinesis_stream_name)"
                                    echo "PROCESSING_FUNCTION_NAME=$(terraform output -raw processing_function_name)"
                                    echo "EVENT_SOURCE_MAPPING_ID=$(terraform output -raw processing_event_source_mapping_id)"
                                    echo "IOT_RULE_NAME=$(terraform output -raw iot_rule_name)"
                                    echo "INGESTION_QUEUE_URL=$(terraform output -raw ingestion_queue_url)"
                                    echo "INGESTION_DLQ_URL=$(terraform output -raw ingestion_dlq_url)"
                                    echo "RAW_BUCKET_NAME=$(terraform output -raw raw_bucket_name)"
                                    echo "PROCESSED_BUCKET_NAME=$(terraform output -raw processed_bucket_name)"
                                } > smoke.env
                            '''
                        }
                    }
                    docker.image("amazon/aws-cli:${AWS_CLI_VERSION}").inside('--entrypoint=') {
                        dir(TF_DIR) {
                            sh 'sh scripts/smoke-test.sh'
                        }
                    }
                }
            }
            post {
                failure {
                    script {
                        env.FAILED_STAGE = STAGE_NAME
                        def failures = "${TF_DIR}/smoke-failures.txt"
                        def detail = fileExists(failures) ? readFile(failures).trim() : ''
                        env.FAILURE_DETAIL = "${detail}\n\n이번 빌드에서 Lambda 이미지가 바뀌었다면 digest 커밋을 되돌려 복구하세요.".trim()
                    }
                }
            }
        }
    }

    post {
        always {
            // tfplan(바이너리)과 tfplan.json에는 민감한 값이 그대로 들어 있어 보관하지 않습니다.
            archiveArtifacts artifacts: "${TF_DIR}/tfplan.txt, ${TF_DIR}/plan-summary.txt", allowEmptyArchive: true
        }
        success {
            script {
                def result = env.BRANCH_NAME != 'main' ? 'Plan 완료 (main에 머지되면 적용)'
                           : env.HAS_CHANGES == 'true' ? '적용 완료'
                           : '변경 없음'
                def summary = env.PLAN_SUMMARY ? "\n```\n${env.PLAN_SUMMARY}\n```" : ''
                slackSend(
                    channel: env.SLACK_CHANNEL,
                    color: 'good',
                    message: ":white_check_mark: *${env.JOB_NAME}* #${env.BUILD_NUMBER} ${result}${summary}\n" +
                             "<${env.BUILD_URL}|빌드 보기>"
                )
            }
        }
        aborted {
            script {
                // 승인 대기 중이 아니면 수동 중단입니다. Apply 도중일 수 있어 미적용으로 안내하지 않습니다.
                def reason = env.APPROVAL_PENDING == 'true'
                    ? '중단 (승인 거절 또는 승인 시간 초과)\nmain 코드가 아직 적용되지 않았습니다. revert PR을 올리거나 Build Now로 다시 실행하세요.'
                    : '중단'
                slackSend(
                    channel: env.SLACK_CHANNEL,
                    color: '#808080',
                    message: ":no_entry_sign: *${env.JOB_NAME}* #${env.BUILD_NUMBER} ${reason}\n" +
                             "<${env.BUILD_URL}|빌드 보기>"
                )
            }
        }
        failure {
            script {
                def detail = env.FAILURE_DETAIL ? "\n```\n${env.FAILURE_DETAIL}\n```" : ''
                slackSend(
                    channel: env.SLACK_CHANNEL,
                    color: 'danger',
                    message: ":x: *${env.JOB_NAME}* #${env.BUILD_NUMBER} 실패\n" +
                             "실패 단계: ${env.FAILED_STAGE ?: '콘솔 로그 확인'}${detail}\n" +
                             "<${env.BUILD_URL}console|콘솔 로그 보기>"
                )
            }
        }
        cleanup {
            // tfplan 등 민감한 파일이 남지 않도록 워크스페이스를 비웁니다.
            cleanWs()
        }
    }
}
