# 웹훅 URL은 Vault 값(vault_alertmanager_slack_webhook_url)에서 온다. 채널은 웹훅을 만들 때 정해진다.
global:
  slack_api_url: "{{ alertmanager_slack_webhook_url }}"

# Slack 메시지 양식(제목·색·본문). files/slack.tmpl을 같은 폴더에 복사해 둔다
templates:
  - /etc/alertmanager/*.tmpl

route:
  receiver: slack
  # 같은 알림 이름·환경·클러스터끼리 메시지 1개로 묶는다
  group_by: [alertname, env, cluster]
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 4h
  routes:
    # 항상 울리는 하트비트라 Slack으로 보내면 4시간마다 의미 없는 메시지가 온다.
    # 이후 외부 하트비트 서비스로 라우팅한다.
    - matchers: ['alertname = "Watchdog"']
      receiver: "null"

    # 사건형 알림(규칙에 type: event). "최근 N분 안에 일이 있었다"는 조건이라 시간이 지나면 저절로 풀린다.
    # 이때의 RESOLVED는 문제가 해결됐다는 뜻이 아니므로 보내지 않는다.
    - matchers: ['type = "event"']
      receiver: slack-event

# 같은 디스크에 critical이 울리면 warning은 보내지 않는다
inhibit_rules:
  - source_matchers: ['alertname = "NodeDiskCritical"']
    target_matchers: ['alertname = "NodeDiskAlmostFull"']
    equal: [cluster, instance, mountpoint]

  - source_matchers: ['alertname = "KubePersistentVolumeCritical"']
    target_matchers: ['alertname = "KubePersistentVolumeFillingUp"']
    equal: [cluster, namespace, persistentvolumeclaim]

  # Vault 전용 알림이 있으므로 같은 대상의 일반 TargetDown은 보내지 않는다
  - source_matchers: ['alertname = "VaultSealedOrDown"']
    target_matchers: ['alertname = "TargetDown"']
    equal: [cluster, instance, job]

# title_link: 기본값은 내부 주소(http://alertmanager:9093)라 브라우저에서 열리지 않으므로 링크를 뺀다
receivers:
  - name: "null"

  - name: slack
    slack_configs:
      - send_resolved: true
        title_link: ""
{% raw %}
        pretext: '{{ template "dangubi.pretext" . }}'
        title: '{{ template "dangubi.title" . }}'
        color: '{{ template "dangubi.color" . }}'
        text: '{{ template "dangubi.text" . }}'

  - name: slack-event
    slack_configs:
      - send_resolved: false
        title_link: ""
        pretext: '{{ template "dangubi.pretext" . }}'
        title: '{{ template "dangubi.title" . }}'
        color: '{{ template "dangubi.color" . }}'
        text: '{{ template "dangubi.text" . }}'
{% endraw %}
