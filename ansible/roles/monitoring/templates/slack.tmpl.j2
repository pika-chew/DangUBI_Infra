{# Grafana 주소만 Ansible 변수로 넣고, 나머지는 Alertmanager 템플릿 문법이라 raw로 그대로 둔다 #}
{% raw %}{{ define "dangubi.grafana_url" }}{% endraw %}{{ grafana_external_url }}{% raw %}{{ end }}{% endraw %}

{% raw %}
{{/*
  DangUBI Slack 알림 양식. alertmanager.yml의 slack_configs에서 template으로 불러 쓴다.

  FIRING                                     RESOLVED
  ⚠️ [warning] KubePodNotReady · 2건 (해결 1건)  ✅ [warning] NodeMemoryHigh · 해결
  - 대상 : k8s                               - 대상 : openstack
  - 심각도 : warning                          - 심각도 : warning
                                             - 설명 : os-ctl2
  - 설명 : summary                            - 발생 : 16:31
  - 발생 : 17:14 ~                            - 해결 : 17:00
  - 로그 : 로그 보기
                                             (여러 건이면 설명·발생·해결 묶음을
  - 설명 : summary                             빈 줄로 나눠 반복)
  - 발생 : 17:15 ~
  - 로그 : 로그 보기

  - 해결됨 :
      • 대상 이름 (16:50 ~ 17:20)
  알림마다 설명·발생·로그 묶음을 빈 줄로 나눠 반복한다. description이 있으면 "- 영향 :" 줄 추가.
  로그 줄은 규칙에 log_query annotation이 있는 알림에만 붙고, 1건일 때만 쿼리도 함께 보인다.
*/}}

{{/* 대상 이름: 있는 라벨 중 가장 구체적인 것을 쓴다 */}}
{{ define "dangubi.target" -}}
{{- if .Labels.pod }}{{ .Labels.namespace }}/{{ .Labels.pod }}
{{- else if .Labels.persistentvolumeclaim }}{{ .Labels.namespace }}/{{ .Labels.persistentvolumeclaim }}
{{- else if .Labels.deployment }}{{ .Labels.namespace }}/{{ .Labels.deployment }}
{{- else if .Labels.statefulset }}{{ .Labels.namespace }}/{{ .Labels.statefulset }}
{{- else if .Labels.job_name }}{{ .Labels.namespace }}/{{ .Labels.job_name }}
{{- else if .Labels.node }}{{ .Labels.node }}
{{- else }}{{ .Labels.instance }}{{ with .Labels.mountpoint }} {{ . }}{{ end }}{{ with .Labels.device }} {{ . }}{{ end }}
{{- end -}}
{{- end }}

{{/* 컨테이너 시간대가 UTC라 9시간(나노초)을 더해 한국 시간으로 표시 */}}
{{ define "dangubi.kst" }}{{ (.Add 32400000000000).Format "15:04" }}{{ end }}

{{/* 색 막대 위 첫 줄 */}}
{{ define "dangubi.pretext" }}{{ .Status | toUpper }}{{ end }}

{{/*
  제목: 발생 critical 🚨 / warning ⚠️ / info 📢, 해결 ✅
  같은 묶음에 이미 해결된 알림이 섞여 있으면 FIRING이어도 "(해결 N건)"을 붙인다
*/}}
{{ define "dangubi.title" -}}
{{- if eq .Status "firing" -}}
{{- if eq .CommonLabels.severity "critical" }}🚨{{ else if eq .CommonLabels.severity "warning" }}⚠️{{ else }}📢{{ end }} [{{ .CommonLabels.severity }}] {{ .CommonLabels.alertname }} · {{ .Alerts.Firing | len }}건{{ with .Alerts.Resolved }} (해결 {{ len . }}건){{ end }}
{{- else -}}
✅ [{{ .CommonLabels.severity }}] {{ .CommonLabels.alertname }} · 해결
{{- end -}}
{{- end }}

{{/* 메시지 왼쪽 색 막대 */}}
{{ define "dangubi.color" -}}
{{- if eq .Status "firing" -}}
{{- if eq .CommonLabels.severity "critical" }}danger{{ else if eq .CommonLabels.severity "warning" }}warning{{ else }}#439FE0{{ end -}}
{{- else }}good{{ end -}}
{{- end }}

{{/* 시간: 발생은 "시작~", 사건형(type=event)은 시각만, 해결은 "시작 ~ 끝" */}}
{{ define "dangubi.firing_time" }}{{ template "dangubi.kst" .StartsAt }}{{ if ne .Labels.type "event" }} ~{{ end }}{{ end }}
{{ define "dangubi.resolved_time" }}{{ template "dangubi.kst" .StartsAt }} ~ {{ template "dangubi.kst" .EndsAt }}{{ end }}

{{/*
  Grafana Explore 링크. Loki 데이터소스(uid=loki)에 log_query를 넣고 알림 시각 1시간 전 ~ 5분 후를 연다.
  js: 쿼리 안의 큰따옴표를 JSON 문자열로 쓸 수 있게 이스케이프, urlquery: 주소에 넣을 수 있게 인코딩
*/}}
{{ define "dangubi.logs_url" -}}
{{ template "dangubi.grafana_url" }}/explore?orgId=1&schemaVersion=1&panes=
{{- printf `{"a":{"datasource":"loki","queries":[{"refId":"A","datasource":{"type":"loki","uid":"loki"},"expr":"%s"}],"range":{"from":"%d","to":"%d"}}}` (js .Annotations.log_query) (.StartsAt.Add -3600000000000).UnixMilli (.StartsAt.Add 300000000000).UnixMilli | urlquery }}
{{- end }}
{{ define "dangubi.logs_link" }}<{{ template "dangubi.logs_url" . }}|로그 보기>{{ end }}

{{/*
  본문. 같은 값(대상·심각도·영향)은 한 번만, 설명·시간·로그는 알림마다.
  해결된 알림은 마지막 값이 남은 summary 대신 대상 이름을 쓴다.
*/}}
{{ define "dangubi.text" -}}
- *대상* : `{{ .CommonLabels.cluster }}`
- *심각도* : `{{ .CommonLabels.severity }}`
{{ with .CommonAnnotations.description }}- *영향* : {{ . }}
{{ end -}}
{{ $single := eq (len .Alerts.Firing) 1 -}}
{{ range .Alerts.Firing }}
- *설명* : {{ .Annotations.summary }}
- *발생* : {{ template "dangubi.firing_time" . }}
{{ if .Annotations.log_query }}- *로그* : {{ template "dangubi.logs_link" . }}{{ if $single }}  `{{ .Annotations.log_query }}`{{ end }}
{{ end -}}
{{ end -}}
{{ if eq .Status "resolved" -}}
{{ range .Alerts.Resolved }}
- *설명* : {{ template "dangubi.target" . }}
- *발생* : {{ template "dangubi.kst" .StartsAt }}
- *해결* : {{ template "dangubi.kst" .EndsAt }}
{{ end -}}
{{ else if .Alerts.Resolved }}
- *해결됨* :
{{ range .Alerts.Resolved }}      • {{ template "dangubi.target" . }} ({{ template "dangubi.resolved_time" . }})
{{ end -}}
{{ end -}}
{{- end }}
{% endraw %}
