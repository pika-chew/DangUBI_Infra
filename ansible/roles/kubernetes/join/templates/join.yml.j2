# 토큰과 인증서 키가 포함되므로 /run에 잠시 저장하고 가입 후 삭제합니다.
apiVersion: kubeadm.k8s.io/v1beta4
kind: JoinConfiguration
discovery:
  bootstrapToken:
    apiServerEndpoint: {{ kubernetes_api_endpoint | to_json }}
    token: {{ kubernetes_join_token.stdout | trim | to_json }}
    caCertHashes:
      - {{ ('sha256:' ~ (kubernetes_ca_hash.stdout | trim)) | to_json }}
nodeRegistration:
  name: {{ inventory_hostname | to_json }}
  criSocket: {{ kubernetes_cri_socket | to_json }}
  kubeletExtraArgs:
    - name: node-ip
      value: {{ kubernetes_node_ip | to_json }}
    - name: node-labels
      value: {{ ('dangubi.io/physical-host=' ~ kubernetes_physical_host) | to_json }}
{% if kubernetes_external_cloud_provider %}
    - name: cloud-provider
      value: external
{% endif %}
{% if inventory_hostname in groups['kubernetes_control_plane'] %}
# Worker는 이 항목을 생략하며, 추가 CP만 인증서를 받아 control plane으로 가입합니다.
controlPlane:
  localAPIEndpoint:
    advertiseAddress: {{ kubernetes_node_ip | to_json }}
    bindPort: 6443
  certificateKey: {{ kubernetes_certificate_key.stdout | trim | to_json }}
{% endif %}
