# 모든 CP와 노드가 공유할 API endpoint를 지정합니다. 외부 관리 주소는 certSANs에 추가합니다.
apiVersion: kubeadm.k8s.io/v1beta4
kind: InitConfiguration
bootstrapTokens:
  - ttl: {{ kubernetes_join_token_ttl | to_json }}
localAPIEndpoint:
  advertiseAddress: {{ kubernetes_node_ip | to_json }}
  bindPort: 6443
nodeRegistration:
  name: {{ inventory_hostname | to_json }}
  criSocket: {{ kubernetes_cri_socket | to_json }}
  kubeletExtraArgs:
    - name: node-ip
      value: {{ kubernetes_node_ip | to_json }}
    - name: node-labels
      value: {{ ('dangubi.io/physical-host=' ~ kubernetes_physical_host) | to_json }}
{% if kubernetes_external_cloud_provider %}
    - name: cloud-provider
      value: external
{% endif %}
---
apiVersion: kubeadm.k8s.io/v1beta4
kind: ClusterConfiguration
kubernetesVersion: {{ ('v' ~ kubernetes_version) | to_json }}
controlPlaneEndpoint: {{ kubernetes_api_endpoint | to_json }}
apiServer:
  certSANs: {{ ([kubernetes_api_endpoint.rsplit(':', 1)[0]] + kubernetes_api_cert_sans) | unique | list | to_json }}
networking:
  podSubnet: {{ kubernetes_pod_cidr | to_json }}
  serviceSubnet: {{ kubernetes_service_cidr | to_json }}
---
apiVersion: kubelet.config.k8s.io/v1beta1
kind: KubeletConfiguration
cgroupDriver: systemd
